# Copy to %ProgramData%\Kawal-Trace\agent.env and restrict ACL to SYSTEM + Administrators.
# The agent gathers an allowlist of Windows Event IDs and sends encrypted telemetry.
KAWAL_WIN_HOST_ID=win-lab-01
KAWAL_API_BASE_URL=https://chainlog-api.example.invalid
KAWAL_WIN_INGEST_TOKEN=REPLACE_WITH_HOST_SCOPED_TOKEN_64_HEX
KAWAL_TRACE_E2EE_PUBLIC_KEY_B64=REPLACE_WITH_DASHBOARD_PUBLIC_KEY
KAWAL_TRACE_E2EE_REQUIRED=true
KAWAL_WIN_OUTBOX_DB=C:\ProgramData\Kawal-Trace\outbox.sqlite3
KAWAL_WIN_POLL_SECONDS=10
KAWAL_WIN_PYTHON=C:\Program Files\Kawal-Trace\agent-venv\Scripts\python.exe
# Response stays off until separately approved and configured on BOTH API and endpoint.
KAWAL_WIN_RESPONSE_ENABLED=false
KAWAL_WIN_PROTECTED_USERS=Administrator,SYSTEM,LOCAL SERVICE,NETWORK SERVICE
KAWAL_WIN_PROTECTED_PROCESSES=lsass.exe,csrss.exe,winlogon.exe,services.exe,smss.exe,svchost.exe,system,explorer.exe,dwm.exe
