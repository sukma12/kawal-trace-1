# Owner-only API management key is created separately by setup_admin_token.py.
# Do not paste this key into agent token maps.
KAWAL_ADMIN_TOKEN=

# Token maps use ID|TOKEN; separate multiple pairs with semicolons.
# The installer creates this root-only file. Run setup_tokens.py to create real tokens.
KAWAL_AUDIT_TOKENS=
KAWAL_MONITOR_TOKENS=
KAWAL_INGEST_TOKENS=
KAWAL_API_HOST=127.0.0.1
KAWAL_API_PORT=8765
KAWAL_API_DB_PATH=/var/lib/kawal-trace-api/events.sqlite3
# The app keeps every database on the user's device. Leave this false unless you must serve an older app version
# that still uploads its audit chain / log archive here. Security events from monitored hosts are unaffected.
KAWAL_API_ACCEPT_CLIENT_DATA=false

# Real-time stream (GET /api/v1/stream). Defaults are sensible; change only with a reason.
# KAWAL_STREAM_HEARTBEAT_SECONDS=15      # keep-alive + token re-check interval (0.05-30); must stay well under 100 s for Cloudflare
# KAWAL_STREAM_WATCH_SECONDS=1           # how often the shared watcher looks at the database (0.02-10)
# KAWAL_STREAM_MAX_TOTAL=32              # open streams across all devices
# KAWAL_STREAM_MAX_PER_IDENTITY=2        # a newer stream from the same device replaces its oldest
# KAWAL_STREAM_MAX_LIFETIME_SECONDS=3600 # the app reconnects by itself

# Behind Cloudflare Tunnel the API reads the real client address from CF-Connecting-IP (only when the TCP peer is
# the local tunnel daemon). Set to false if something other than cloudflared sits in front of the API.
# KAWAL_TRUST_CF_CONNECTING_IP=true

# Optional containment. Disabled by default. Use only on hosts you administer.
# After entering the real trusted administrator public IPv4 address(es), set enabled=true.
KAWAL_RESPONSE_TOKENS=
KAWAL_RESPONSE_ACTIONS_ENABLED=false
KAWAL_RESPONSE_ALLOWLIST=

# Device second factor: DEVICE_ID|BASE32_SECRET; setup_tokens.py generates this once.
KAWAL_RESPONSE_TOTP_SECRETS=

# Enrolled Windows hosts: HOST_ID|TOKEN; separate token from dashboard token.
KAWAL_WINDOWS_HOST_TOKENS=
KAWAL_WINDOWS_RESPONSE_ENABLED=false
