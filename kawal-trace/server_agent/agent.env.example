# Copy to /etc/kawal-trace-agent/agent.env and replace every example value.
# Use separate write-only token for the Linux agent and read-only token for dashboard.
KAWAL_TRACE_HOST_ID=srv-lab-01
KAWAL_TRACE_INGEST_URL=https://api.example.invalid
KAWAL_TRACE_API_TOKEN=REPLACE_WITH_RANDOM_DEVICE_SCOPED_TOKEN_32PLUS_CHARS
KAWAL_TRACE_OUTBOX_DB=/var/lib/kawal-trace-agent/outbox.sqlite3
KAWAL_TRACE_AUDIT_LOG=/var/log/audit/audit.log
# Optional private CA bundle if the server uses an internal CA:
# KAWAL_TRACE_CA_BUNDLE=/etc/ssl/certs/internal-ca-bundle.pem

# Optional local MaxMind MMDB database paths; no third-party lookup is made.
# Download/manage GeoLite2 databases according to provider terms. GeoIP locations are approximate.
# KAWAL_TRACE_GEOIP_CITY_DB=/usr/share/GeoIP/GeoLite2-City.mmdb
# KAWAL_TRACE_GEOIP_ASN_DB=/usr/share/GeoIP/GeoLite2-ASN.mmdb

# Default project folder for the server used in this deployment. Change this path only
# when the application files live elsewhere; the matching auditd rule is in
# auditd-chainlog.rules. The desktop app starts displaying events automatically
# after this agent reports READY and the server profile is connected.
KAWAL_TRACE_WATCH_ROOTS=/home/server/Anime_Projeck

# Optional local ClamAV signature scan after a watched file changes.
# Only watched FILE_CHANGE events are scanned; no full-disk scan or auto-delete.
# Install/update ClamAV signatures first; scanning is disabled by default.
# KAWAL_TRACE_CLAMSCAN_ENABLED=true
# KAWAL_TRACE_CLAMSCAN_ROOTS=/home/server/Anime_Projeck

# E2EE receiver public key. Required by default for internet API delivery.
# Copy only the public key from the Kawal-Trace dashboard's E2EE panel.
KAWAL_TRACE_E2EE_PUBLIC_KEY_B64=REPLACE_WITH_DASHBOARD_PUBLIC_KEY
KAWAL_TRACE_E2EE_REQUIRED=true
# Do not set KAWAL_TRACE_ALLOW_LEGACY_TLS=true on an internet endpoint.
